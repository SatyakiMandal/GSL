+                             [date(2023, 1, d) for d in range(2, 21)
+                              if date(2023, 1, d).weekday() < 5]})
+        diag = flagging_diagnostics(table)
+        incidents = rank_incidents(table, frame, return_threshold=1.5)
+        assert diag["candidates"] == len(incidents)
